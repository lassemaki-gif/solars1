# Google Maps Platform — enable Solar API + Places API + Maps JS API
GOOGLE_MAPS_API_KEY=your_key_here

# Comma-separated CORS origins — include all frontend origins
FRONTEND_ORIGINS=https://solars.solutions,https://www.solars.solutions,http://localhost:3000

# SQLite for dev; swap to Postgres in prod (e.g. postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./solarscope.db

# Nordic financial model defaults — override per-country in code if needed
DEFAULT_ELECTRICITY_PRICE_EUR_PER_KWH=0.18
DEFAULT_FEED_IN_PRICE_EUR_PER_KWH=0.05
DEFAULT_INSTALL_COST_EUR_PER_KWP=1500
DEFAULT_SELF_CONSUMPTION_RATIO=0.45
DEFAULT_ANNUAL_DEGRADATION=0.005
DEFAULT_DISCOUNT_RATE=0.03
DEFAULT_ANALYSIS_YEARS=25
